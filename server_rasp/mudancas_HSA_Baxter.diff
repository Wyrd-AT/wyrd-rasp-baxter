-            else:
-                action = "OUT"
-                if asset.quarto:
-                    nome_quarto_evento = asset.quarto.nome
-            
-            event = ReceivedEvent(
-                esp_id=change["source_esp_id"],
-                ativo=asset.mac_beacon,
-                quarto_nome=nome_quarto_evento,
-                action=action,
-                status="OK",
-                status_detail=change["details"],
