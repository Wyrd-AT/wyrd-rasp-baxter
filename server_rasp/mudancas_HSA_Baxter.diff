+
+                {# 4. Quarto #}
+                <td>{{ emb.quarto.nome if emb.quarto else '---' }}</td>
+
+                {# 5. Status #}
+                <td>
+                    {% if emb.status_rede == 'online' %}
+                        <span class="status-indicator online" title="Último contato: {{ emb.last_seen_str }}"></span> ON
+                    {% else %}
+                        <span class="status-indicator offline" title="Último contato: {{ emb.last_seen_str }}"></span> OFF
+                    {% endif %}
+                </td>
+
+                {# 6. Sinal Wi-Fi #}
+                <td>
+                    {% if emb.wifi_signal %}
+                        {{ emb.wifi_signal }} dBm
+                    {% else %}
+                        ---
+                    {% endif %}
+                </td>
+
+                {# 7. MAC Address #}
+                <td>{{ emb.mac_address or '---' }}</td>
+
+                {# 8. IP Address #}
+                <td>{{ emb.ip_address or '---' }}</td>
+
+                {# 9. RSSI Mín. #}
+                <td>
+                    {% if emb.rssi_threshold is not none %}
+                        <span title="RSSI Individual">{{ emb.rssi_threshold }}</span>
+                    {% else %}
+                        <span title="Usando Configuração Global" style="color: #999;">Global</span>
+                    {% endif %}
+                </td>
+            </tr>
+            {% endfor %}
+        </tbody>
+    </table>
+</div>
+
+{% endblock %}
+
+{% block scripts %}
+<script>
+document.addEventListener('DOMContentLoaded', function () {
+    // --- LÓGICA DO MODAL (sem alterações) ---
+    const modal = document.getElementById('rssi-modal');
+    const modalTitle = document.getElementById('modal-title');
+    const modalBody = document.getElementById('modal-body-content');
+    const closeBtn = document.getElementById('modal-close-btn');
+
+    if (modal && closeBtn) {
+        closeBtn.onclick = () => { modal.style.display = "none"; };
+        window.onclick = (event) => {
+            if (event.target == modal) {
+                modal.style.display = "none";
+            }
+        };
+    }
+
+    document.querySelectorAll('.actions-menu-trigger').forEach(button => {
+        button.addEventListener('click', function (event) {
+            event.stopPropagation();
+            document.querySelectorAll('.actions-dropdown.show').forEach(d => {
+                if (d !== this.nextElementSibling) d.classList.remove('show');
+            });
+            this.nextElementSibling.classList.toggle('show');
+        });
+    });
+
+    window.addEventListener('click', (event) => {
+        if (!event.target.matches('.actions-menu-trigger')) {
+            document.querySelectorAll('.actions-dropdown.show').forEach(d => d.classList.remove('show'));
+        }
+    });
+    
+    const rssiThresholds = JSON.parse('{{ rssi_thresholds | safe }}');
+    let assetNameMap = {};
+
+    fetch("{{ url_for('get_assets_map') }}")
+        .then(response => response.json())
+        .then(data => { assetNameMap = data; });
+
+});
+</script>
+{% endblock %}
