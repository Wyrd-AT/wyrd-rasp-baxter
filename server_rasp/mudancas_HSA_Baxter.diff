-            db.add(event)
-
-            asset.quarto_id = new_quarto_id
-
-        db.commit()
-        
-        logger.info(f"Lote de {len(changes)} mudanças processado e salvo com sucesso.")
-        await manager.broadcast("ATUALIZAR_ESTADO")
